// Algebra mutations select the Map with more than one expanded singleton, not
// the independent Fold-driven one-axis expansion in the same RMSNorm region.
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra '--shuttle-test-mutate-projected-parameter-map=kind=divisor' --verify-each=false --shuttle-plan-row-fold-materialization 2>&1 | FileCheck %s --check-prefix=MAP
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra '--shuttle-test-mutate-projected-parameter-map=kind=composite' --verify-each=false --shuttle-plan-row-fold-materialization 2>&1 | FileCheck %s --check-prefix=MAP
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra '--shuttle-test-mutate-projected-parameter-map=kind=ceildiv' --verify-each=false --shuttle-plan-row-fold-materialization 2>&1 | FileCheck %s --check-prefix=MAP
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra '--shuttle-test-mutate-projected-parameter-map=kind=mod' --verify-each=false --shuttle-plan-row-fold-materialization 2>&1 | FileCheck %s --check-prefix=MAP
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra '--shuttle-test-mutate-projected-parameter-map=kind=symbol' --verify-each=false --shuttle-plan-row-fold-materialization 2>&1 | FileCheck %s --check-prefix=MAP
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra '--shuttle-test-mutate-projected-parameter-map=kind=duplicate' --verify-each=false --shuttle-plan-row-fold-materialization 2>&1 | FileCheck %s --check-prefix=MAP
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra '--shuttle-test-mutate-projected-parameter-map=kind=direct' --verify-each=false --shuttle-plan-row-fold-materialization 2>&1 | FileCheck %s --check-prefix=MAP
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra '--shuttle-test-mutate-projected-parameter-map=kind=result' --verify-each=false --shuttle-plan-row-fold-materialization 2>&1 | FileCheck %s --check-prefix=MAP

// Plan and schedule mutations refresh fingerprints and target the multiply-
// expanded parameter task by decoded input/output shapes.
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization '--shuttle-test-mutate-map-materialization=kind=projected-domain' --shuttle-verify-materialization-plan 2>&1 | FileCheck %s --check-prefix=MATERIALIZATION
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization '--shuttle-test-mutate-map-materialization=kind=projected-dependency' --shuttle-verify-materialization-plan 2>&1 | FileCheck %s --check-prefix=MATERIALIZATION
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization --shuttle-plan-simt32-row-fold-schedule '--shuttle-test-mutate-map-schedule=kind=projected-grid' --shuttle-verify-simt32-row-fold-schedule 2>&1 | FileCheck %s --check-prefix=GEOMETRY
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-test-set-fast-region-policy --shuttle-plan-row-fold-materialization --shuttle-plan-simt32-row-fold-schedule '--shuttle-test-mutate-map-schedule=kind=projected-grid' --shuttle-verify-simt32-row-fold-schedule 2>&1 | FileCheck %s --check-prefix=GEOMETRY
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization --shuttle-plan-simt32-row-fold-schedule --shuttle-build-gpu-executable-bundle '--shuttle-test-corrupt-executable=kind=projected-parameter-body' --shuttle-verify-gpu-executable-bundle 2>&1 | FileCheck %s --check-prefix=PTX

// MAP: requires a bounded set of independently connected static GPU algebra regions
// MATERIALIZATION: materialization
// GEOMETRY: schedule geometry must equal the SIMT32 derivation
// PTX: CUDA PTX slice is not the closed SM90 form
