// The mutators update the owning fingerprints, so failures localize to the
// source-derived prefix algebra, materialization, schedule, and PTX contracts.

// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-backward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization '--shuttle-test-mutate-fold-materialization=kind=prefix-axis' --shuttle-verify-materialization-plan 2>&1 | FileCheck %s --check-prefix=MATERIALIZATION
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-backward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization '--shuttle-test-mutate-fold-materialization=kind=prefix-omit' --shuttle-verify-materialization-plan 2>&1 | FileCheck %s --check-prefix=MATERIALIZATION
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-backward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization '--shuttle-test-mutate-fold-materialization=kind=prefix-swap' --shuttle-verify-materialization-plan 2>&1 | FileCheck %s --check-prefix=MATERIALIZATION
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-composed.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization '--shuttle-test-mutate-fold-materialization=kind=prefix-reduction' --shuttle-verify-materialization-plan 2>&1 | FileCheck %s --check-prefix=MATERIALIZATION
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-composed.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization '--shuttle-test-mutate-fold-materialization=kind=prefix-parallel' --shuttle-verify-materialization-plan 2>&1 | FileCheck %s --check-prefix=MATERIALIZATION
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-composed.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization '--shuttle-test-mutate-fold-materialization=kind=prefix-dependency' --shuttle-verify-materialization-plan 2>&1 | FileCheck %s --check-prefix=MATERIALIZATION

