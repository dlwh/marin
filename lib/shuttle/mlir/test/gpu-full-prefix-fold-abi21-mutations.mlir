// FAST must retain the same full-prefix Fold geometry and fixed leaf order.
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-composed.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-test-set-fast-region-policy --shuttle-plan-row-fold-materialization --shuttle-plan-simt32-row-fold-schedule '--shuttle-test-mutate-fold-schedule=kind=prefix-grid' --shuttle-verify-simt32-row-fold-schedule 2>&1 | FileCheck %s --check-prefix=GEOMETRY
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-composed.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-test-set-fast-region-policy --shuttle-plan-row-fold-materialization --shuttle-plan-simt32-row-fold-schedule '--shuttle-test-mutate-fold-schedule=kind=prefix-order' --shuttle-verify-simt32-row-fold-schedule 2>&1 | FileCheck %s --check-prefix=ORDER
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-3x2x5x11x263-composed.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization --shuttle-plan-simt32-row-fold-schedule --shuttle-test-mutate-schedule-lifetime --shuttle-verify-simt32-row-fold-schedule 2>&1 | FileCheck %s --check-prefix=LIFETIME

// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-projected_parameter_broadcast-2x7x19-backward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization --shuttle-plan-simt32-row-fold-schedule --shuttle-build-gpu-executable-bundle '--shuttle-test-corrupt-executable=kind=prefix-fold-body' --shuttle-verify-gpu-executable-bundle 2>&1 | FileCheck %s --check-prefix=PTX

// MATERIALIZATION: {{requires a bounded set of independently connected static GPU algebra regions|materialization}}
// GEOMETRY: {{requires a bounded set of independently connected static GPU algebra regions|schedule geometry must equal the SIMT32 derivation}}
// AXIS: {{requires a bounded set of independently connected static GPU algebra regions|Fold schedule kind must match its reduction axis}}
// ORDER: {{requires a bounded set of independently connected static GPU algebra regions|Fold reduction order must equal bound Fold semantics}}
// LIFETIME: {{requires a bounded set of independently connected static GPU algebra regions|schedule buffer type and lifetime}}
// PTX: {{requires a bounded set of independently connected static GPU algebra regions|CUDA PTX slice is not the closed SM90 form}}
