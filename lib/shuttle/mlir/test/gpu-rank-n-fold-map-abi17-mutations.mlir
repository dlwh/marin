// The mutators refresh fingerprints, so each failure is a semantic verifier
// failure rather than a stale-integrity-check failure.

// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-rank_n_fold_map-2x5x17-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization '--shuttle-test-mutate-fold-materialization=kind=parallel' --shuttle-verify-materialization-plan 2>&1 | FileCheck %s --check-prefix=MATERIALIZATION
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-bf16-rank_n_fold_map-3x2x4x7x269-forward.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-plan-row-fold-materialization '--shuttle-test-mutate-fold-materialization=kind=reduction' --shuttle-verify-materialization-plan 2>&1 | FileCheck %s --check-prefix=MATERIALIZATION
