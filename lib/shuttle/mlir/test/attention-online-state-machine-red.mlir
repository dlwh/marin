// STATE: online_state_machine = source_bound; state = {m,l,o[Dv]}; score = once; mask_identity = safe; epilogue = exact; public_abi = exact; ptx_semantics = hardware_deferred
// CORRUPT: online device entry lacks the exact typed source state machine
// FALLBACK: online_state = fallback
// NEAR-MISS: requires one source-bound executable materialization plan per GPU region
// SOURCE-ORDERED: requires one closed FAST state-machine executable bundle

module {}
