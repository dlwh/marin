// SOURCE_ORDERED retains the lossless fallback and must fail before GPU
// lowering rather than taking the FAST online route accidentally.
// RUN: not shuttle-test-opt %S/Inputs/jax-0.10.1-f32-causal-gqa-online-axis4.mlir --shuttle-annotate-source --shuttle-form-structural-regions --shuttle-convert-stablehlo-to-algebra --shuttle-verify-source-coverage --shuttle-verify-semantic-erasure --shuttle-test-verify-output-dependency-coverage --shuttle-test-set-prefer-fusion-tuning --shuttle-plan-row-fold-materialization --shuttle-verify-materialization-plan --shuttle-test-verify-online-fallback --shuttle-plan-simt32-row-fold-schedule -o /dev/null 2>&1 | FileCheck %s --check-prefix=SOURCE-ORDERED

// GPU: online_gpu = semantic_state_closed; relation = applied; public_abi = exact; representative_score_materialized = false; resources = observational
// SEMANTICS: online GPU CFG does not prove predicate/update/merge/finalize
// ABI: online GPU operand ABI is not source-bound
// RELATION: online GPU Relation index dataflow is not source-bound
// FALLBACK: requires one source-bound executable materialization plan per GPU region
// SOURCE-ORDERED: requires one source-bound executable materialization plan per GPU region
// ORACLE: online_ptx_oracle_mutations = complete

module {}
