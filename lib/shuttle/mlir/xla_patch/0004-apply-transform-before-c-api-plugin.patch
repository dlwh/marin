+absl::Status ApplyClientStablehloTransform(ProgramVariant& program,
+                                           CompileOptions& options) {
+  auto* module = std::get_if<xla::MaybeOwningMlirModule>(&program);
+  if (module == nullptr) {
+    return absl::OkStatus();
+  }
+  return ApplyStablehloModuleTransform(module->mlir_module(), options);
+}
