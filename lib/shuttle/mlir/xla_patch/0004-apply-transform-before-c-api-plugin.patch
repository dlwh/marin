+absl::Status ApplyStablehloModuleTransform(
+    mlir::ModuleOp module, CompileOptions& compile_options) {
+  TF_RETURN_IF_ERROR(ApplyStablehloTransformOptionOverrides(compile_options));
+  auto& build_options = compile_options.executable_build_options;
+  if (!build_options.has_debug_options() ||
+      !build_options.debug_options().xla_shuttle_enable()) {
+    return absl::OkStatus();
+  }
+  auto* debug_options = build_options.mutable_debug_options();
+  TF_RETURN_IF_ERROR(StablehloModuleTransformRegistry::Global().Run(
+      module, debug_options->xla_shuttle_options(),
+      /*required_transform=*/"shuttle"));
+  debug_options->set_xla_shuttle_enable(false);
+  auto& overrides = compile_options.env_option_overrides;
+  overrides.erase(
+      std::remove_if(overrides.begin(), overrides.end(), [](const auto& item) {
+        return item.first == kShuttleEnableOption;
+      }),
+      overrides.end());
+  return absl::OkStatus();
+}

