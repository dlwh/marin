+def _aux_smem_struct(aux_operands, layouts):
+    if not aux_operands:
+        return cute.struct.MemRange[Int32, 0]
+    fields = {}
+    for index, (aux, layout) in enumerate(zip(aux_operands, layouts)):
+        size = cute.cosize(layout)
+        assert size * aux.dtype.width // 8 % 128 == 0, "aux staged allocations require 128-byte size"
